# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL / PostgreSQL / Supabase connection variables
# Configure these in your Vercel Project Settings > Environment Variables
SQL_HOST="localhost"
SQL_USER="postgres"
SQL_PASSWORD="your-database-password"
SQL_DB_NAME="postgres"
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD="your-admin-password"
